<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScholarshipPipeline.Tests" />
  </ItemGroup>

  <!-- Sample data is copied next to the application, so a start without arguments works from any working directory. -->
  <ItemGroup>
    <Content Include="..\..\data\*.csv" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native library (built from ../../native/scholarship_native.c, see README). The binary for the current OS/architecture
       is copied next to the application, where the runtime resolves DllImport("scholarship_native"). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
    <Content Include="..\..\native\lib\linux-x64\libscholarship_native.so" Link="libscholarship_native.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
    <Content Include="..\..\native\lib\win-x64\scholarship_native.dll" Link="scholarship_native.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
